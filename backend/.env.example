PORT=4000
NODE_ENV=development

# Long random string used to sign JWTs. Generate e.g. with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=15m

# Frontend origin allowed by CORS (must match where the shop HTML is served from).
FRONTEND_ORIGIN=http://localhost:5173

DB_PATH=./data/gumipont.db

# Public registration always creates a 'user' account. To create the first
# admin account, run: npm run create-admin -- "Name" email@example.com password
# Every admin after that can be created from the app itself (admin-only).
