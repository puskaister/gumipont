PORT=4000
NODE_ENV=development

# Long random string used to sign JWTs. Generate e.g. with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=15m

# Code that must be supplied at /api/auth/register to receive the 'admin' role.
# Never expose this value in client-side code.
ADMIN_REGISTRATION_CODE=change-this-admin-code

# Frontend origin allowed by CORS (must match where the shop HTML is served from).
FRONTEND_ORIGIN=http://localhost:5173

DB_PATH=./data/gumipont.db
